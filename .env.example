LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SEGUNDOS=90
LLM_MAX_REINTENTOS=2

EMBEDDING_MODEL=text-embedding-3-small
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=ecoruta_conocimiento
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=60
RAG_TOP_K=5
RAG_PESO_VECTORIAL=0.6

REDIS_URL=redis://localhost:6379/0
CHECKPOINTER=redis
CHECKPOINT_TTL_MINUTOS=10080
JOB_TTL_SEGUNDOS=604800

MAX_JOBS=5
JOB_TIMEOUT_SEGUNDOS=300

OBSERVABILIDAD=phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=intelligence-system

MAX_PASOS_SUPERVISOR=10
MAX_INTENTOS_POR_TAREA=2
MAX_REVISIONES=2
PUNTAJE_MINIMO_RUBRICA=4
RECURSION_LIMIT_GRAFO=60
RECURSION_LIMIT_ESPECIALISTA=16
TURNOS_DE_CONTEXTO=3
UMBRAL_TOKENS_APROBACION=80000
